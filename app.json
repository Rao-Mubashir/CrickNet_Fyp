{
  "expo": {
    "name": "CrickVision",
    "slug": "crickvision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.usman.crickvision",
      "infoPlist": {
        "NSCameraUsageDescription": "CrickVision needs camera access to record cricket deliveries for AI analysis.",
        "NSMicrophoneUsageDescription": "CrickVision needs microphone access when recording video.",
        "NSPhotoLibraryUsageDescription": "CrickVision needs gallery access to select videos for analysis."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.usman.crickvision",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./src/assets/logo.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CrickVision to access your camera to record deliveries."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CrickVision to access your photo library."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1b3a4ad5-9f0f-43be-82bf-9a4ec2e879f2"
      }
    }
  }
}
